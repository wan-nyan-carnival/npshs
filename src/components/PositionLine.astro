---
interface Props {
  x1: number;
  y1: number;
  x2: number;
  y2: number;
  viewWidth?: number;
  viewHeight?: number;
}

const {
  x1,
  y1,
  x2,
  y2,
  viewWidth = 400,
  viewHeight = 203,
} = Astro.props;
---

<svg
  class="position-line"
  viewBox={`0 0 ${viewWidth} ${viewHeight}`}
  preserveAspectRatio="none"
>

  <!-- 白い半透明の四角 -->
  <rect
    x={Math.min(x1, x2) - 0.5}
    y={Math.min(y1, y2) - 0.5}
    width={Math.abs(x2 - x1) + 1}
    height={Math.abs(y2 - y1) + 1}
    fill="white"
    opacity="0.5"
  />

  <!-- 赤いX（上に描く） -->
  <line
    x1={x1}
    y1={y1}
    x2={x2}
    y2={y2}
    stroke="red"
    stroke-width="2"
    stroke-linecap="butt"
    vector-effect="non-scaling-stroke"
  />

  <line
    x1={x2}
    y1={y1}
    x2={x1}
    y2={y2}
    stroke="red"
    stroke-width="2"
    stroke-linecap="butt"
    vector-effect="non-scaling-stroke"
  />

</svg>

<style>
.position-line {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;

  opacity: 0;
  transition: opacity 0.2s ease;
}

.position-line.show {
  opacity: 1;
}
</style>