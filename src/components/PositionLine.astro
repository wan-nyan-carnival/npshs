---
interface Props {
  x1: number;
  y1: number;
  x2: number;
  y2: number;
  viewWidth?: number;
  viewHeight?: number;
  stroke?: string;
  strokeWidth?: number;
}

const {
  x1,
  y1,
  x2,
  y2,
  viewWidth = 400,
  viewHeight = 203,
  stroke = "red",
  strokeWidth = 2,
} = Astro.props;
---

<svg
  class="position-line"
  viewBox={`0 0 ${viewWidth} ${viewHeight}`}
  preserveAspectRatio="none"
>
  <line
    x1={x1}
    y1={y1}
    x2={x2}
    y2={y2}
    stroke={stroke}
    stroke-width={strokeWidth}
  />

  <line
    x1={x2}
    y1={y1}
    x2={x1}
    y2={y2}
    stroke={stroke}
    stroke-width={strokeWidth}
  />
</svg>

<style>
.position-line {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;

  opacity: 0;
  transition: opacity 0.2s ease;
}

.position-line.show {
  opacity: 1;
}
</style>