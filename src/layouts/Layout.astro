---
import Topbox from '../components/Topbox.astro';
const BASE = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Newポケモンスナップ ハイスコア攻略</title>

  <!-- CSS -->
  <link rel="stylesheet" href={`${BASE}css/destyle.css`} />
  <link rel="stylesheet" href={`${BASE}css/jquery-ui.min.css`} />
  <link rel="stylesheet" href={`${BASE}css/nps.css`} />

  <!-- JS -->
  <script src={`${BASE}js/loader.js`} defer></script>
</head>
<body>

  <!-- 共通ヘッダー -->
  <Topbox base={BASE} />

  <!-- ページごとの中身。ここで base を slot で渡す -->
  <main>
    <slot base={BASE} />
  </main>

</body>
</html>