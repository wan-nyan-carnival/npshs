---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <a class="pagetop" href="#"><div class="pagetop__arrow"></div></a>

  <div id="main-box">
    <h2>バッフロン（Bouffalant）</h2>

    <div class="tab">
      <div class="tab-buttons">
        <button class="active">★１</button>
        <button>★２</button>
        <button>★３</button>
        <button>★４</button>
      </div>

      <div class="tab-contents">

        <!-- ===================== ★1 ===================== -->
        <div class="content active">
          <div class="kakoi sp">
            <h3>基本情報</h3>
            <div class="column">
              <div class="photo">
                <img src="/npshs/img/5/poke1.png" />
              </div>
              <div class="data">
                <table>
                  <tr>
                    <th>撮影エリア</th>
                    <td>公園(昼) Lv3</td>
                  </tr>
                  <tr>
                    <th>ポーズ</th>
                    <td>変動(1000)</td>
                  </tr>
                  <tr>
                    <th>位置</th>
                    <td>頭</td>
                  </tr>
                  <tr>
                    <th>ほかのポケモン</th>
                    <td>ピチュー、サルノリ、バッフロン、ビビヨン</td>
                  </tr>
                </table>
                <button class="cs" onclick="csLink(0)">★CyberScore</button>
              </div>
            </div>

            <h3>動画</h3>
            <table class="vlink sp">
              <tr>
                <td>Quentin</td>
                <td>5088</td>
                <td>https://www.youtube.com/watch?v=v7XSkgJHEH8</td>
              </tr>
            </table>

            <h3>撮影手順</h3>
            <div class="setup">
              <p>誰か書いて。</p>
            </div>
          </div>
        </div>

