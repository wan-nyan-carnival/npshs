---
import Layout from '../layouts/Layout.astro';
import SideMenu from '../components/SideMenu.astro';
import BackToTop from '../components/BackToTop.astro';
import { pokemonList } from '../data';
import { pokemonGroups } from '../data/groups';

function groupByNo(list, groups) {
  const result = [];

  let start = 1;

  for (const g of groups) {
    const items = list.filter(p => p.no >= start && p.no <= g.endNo);
    result.push({
      label: g.label,
      items
    });
    start = g.endNo + 1;
  }

  return result;
}

const grouped = pokemonGroups.map(group => ({
  id: group.id,
  label: group.label,
  items: pokemonList.filter(
    p => p.groups?.includes(group.label)
  )
}));
---

<Layout>
  <SideMenu groups={pokemonGroups} />
  <BackToTop />
  <div id="main-box">
    {grouped.map(group => (
      <section class="group">
        <h2 id={group.id}>{group.label}</h2>

        <div class="pokelist">
          {group.items.map(p => (
            <div>
              <a href={`/npshs/${p.id}`}>
                <img src={`/npshs/img/poke/${p.no}.png`} width="100" height="100" />
                <br />{p.name}
              </a>
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>
</Layout>